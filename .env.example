# =============================================================================
#  Spin the Wheel — configuration
#  Copier en `.env` puis remplir. Le fichier `.env` n'est jamais commité.
#  Générer les secrets :  openssl rand -hex 32
# =============================================================================

# --- Base de données -------------------------------------------------------
POSTGRES_USER=spinwheel
POSTGRES_PASSWORD=CHANGE_MOI_openssl_rand_hex_32
POSTGRES_DB=spinwheel

# --- Serveur ---------------------------------------------------------------
# Port exposé sur 127.0.0.1 uniquement ; nginx tape dessus.
HTTP_PORT=8080

# Origine publique du site, telle que vue par le navigateur.
# Sert à construire l'URL de callback OAuth et les URLs d'embed.
# PAS de slash final.
BASE_URL=https://wheel.nicolas-legay.fr

# production | development
APP_ENV=production

# debug | info | warn | error
LOG_LEVEL=info

# --- Cookies / proxy -------------------------------------------------------
# true en prod (HTTPS via nginx) → cookie `Secure` + préfixe `__Host-`.
# false uniquement pour tester en http://localhost.
COOKIE_SECURE=true

# true si un reverse proxy de confiance (nginx) place X-Real-IP / X-Forwarded-For.
# Ne jamais mettre true si le serveur est joignable en direct depuis Internet.
TRUST_PROXY=true

# Sel de hachage des IP stockées avec les tirages (pseudonymisation RGPD).
# openssl rand -hex 32
IP_HASH_SALT=CHANGE_MOI_openssl_rand_hex_32

# --- Google OAuth ----------------------------------------------------------
# Console Google Cloud → API et services → Identifiants → ID client OAuth
# Type : « Application Web »
# URI de redirection autorisé : <BASE_URL>/auth/google/callback
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_MOI

# Comptes autorisés à se connecter au premier démarrage (séparés par des virgules).
# Ils sont insérés dans la table `allowed_emails`. Ensuite tout se gère depuis
# le site (page Comptes autorisés).
BOOTSTRAP_ADMIN_EMAILS=nicolas.legay@hafa.fr

# --- Intégration iframe ----------------------------------------------------
# Domaines autorisés à afficher /embed/{id} dans une iframe.
# Valeurs acceptées : URLs https, 'self', http://localhost[:port].
# Séparateur : espace. Le joker `*` est autorisé en sous-domaine uniquement.
EMBED_FRAME_ANCESTORS=https://digipad.app https://*.digipad.app

# --- Limites ---------------------------------------------------------------
# Taille max d'une image uploadée, en octets (2 Mio par défaut).
MAX_IMAGE_BYTES=2097152

# Durée de vie d'une session, en heures.
SESSION_TTL_HOURS=168
